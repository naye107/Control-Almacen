# Variables de ejemplo; no contiene credenciales. Node no carga este archivo automaticamente.
PORT=8080
HOST=127.0.0.1
DATA_DIR=./data
# DATABASE_URL=postgresql://USUARIO:SECRETO@HOST/BASE
# PUBLIC_ORIGIN=https://SU-DOMINIO
# TRUST_PROXY=1 solo detras de un proxy de confianza

# Fase 5A: medir antes de aumentar.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
HTTP_BODY_KIB=128
INVENTORY_BODY_MIB=16
DOCUMENT_CONCURRENCY=2
RESOURCE_RSS_LIMIT_MIB=768
MAINTENANCE_MODE=0
